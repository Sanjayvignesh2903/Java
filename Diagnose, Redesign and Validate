import java.util.*;

public class Q7Aging {

    // The allowance array for severities 1 to 5 (Index 0 is unused)
    // S1: 0, S2: 25, S3: 50, S4: 75, S5: 100
    static final int[] A = {0, 0, 25, 50, 75, 100};

    // --- Original Bottleneck Design ---
    static class OriginalTriage {
        List<Patient> waiting = new ArrayList<>();
        long comparisons = 0;

        void admit(String name, int severity, long arrival) {
            waiting.add(new Patient(name, severity, arrival));
        }

        Patient serve(long now) {
            if (waiting.isEmpty()) return null;

            Comparator<Patient> cmp = (x, y) -> {
                comparisons++;
                long ex = A[x.severity] + (now - x.arrival);
                long ey = A[y.severity] + (now - y.arrival);
                int c = Long.compare(ex, ey);
                return c != 0 ? c : Long.compare(x.arrival, y.arrival);
            };

            // Rebuilds the entire heap on every single serve
            PriorityQueue<Patient> pq = new PriorityQueue<>(waiting.size(), cmp);
            for (Patient p : waiting) {
                pq.add(p);
            }

            Patient best = pq.poll();
            waiting.remove(best); // O(n) removal
            return best;
        }
    }

    // --- Redesigned Optimized Design ---
    static class RedesignedTriage {
        long comparisons = 0;
        
        // Stores array: [key, arrival, id, severity]
        PriorityQueue<long[]> pq = new PriorityQueue<>((x, y) -> {
            comparisons++;
            int c = Long.compare(x[0], y[0]);
            return c != 0 ? c : Long.compare(x[1], y[1]);
        });

        void admit(int id, int sev, long tick) {
            // Key is fixed at admission: allowance + tick
            long key = A[sev] + tick;
            pq.add(new long[]{key, tick, id, sev});
        }

        long[] serve(long now) {
            // 'now' is completely ignored in the redesign since order is invariant
            return pq.poll();
        }
    }

    // Basic Patient class for OriginalTriage
    static class Patient {
        String name;
        int severity;
        long arrival;

        Patient(String name, int severity, long arrival) {
            this.name = name;
            this.severity = severity;
            this.arrival = arrival;
        }
    }

    // --- Benchmark Runner ---
    public static void main(String[] args) {
        System.out.println("--- Q7: Original vs Redesign Benchmark ---\n");
        int[] sizes = {1000, 4000, 16000}; 

        for (int n : sizes) {
            System.out.println("==========================================");
            System.out.println("Testing Size (n) = " + n + " patients");
            System.out.println("==========================================");
            
            // Generate random arrivals
            Random rand = new Random(42);
            int[] severities = new int[n];
            for (int i = 0; i < n; i++) severities[i] = rand.nextInt(5) + 1;

            runOriginal(n, severities);
            runRedesign(n, severities);
        }
    }

    private static void runOriginal(int n, int[] severities) {
        OriginalTriage original = new OriginalTriage();
        
        // Admit all
        for (int i = 0; i < n; i++) {
            original.admit("P" + i, severities[i], i);
        }

        // Measure serving all patients one per tick
        long start = System.nanoTime();
        for (int now = n; now < 2 * n; now++) {
            original.serve(now);
        }
        long timeMs = (System.nanoTime() - start) / 1_000_000;

        System.out.printf("Original (Rebuild Heap) : %6d ms | %10d comparisons%n", timeMs, original.comparisons);
    }

    private static void runRedesign(int n, int[] severities) {
        RedesignedTriage redesign = new RedesignedTriage();
        
        // Admit all
        for (int i = 0; i < n; i++) {
            redesign.admit(i, severities[i], i);
        }

        // Measure serving all patients one per tick
        long start = System.nanoTime();
        for (int now = n; now < 2 * n; now++) {
            redesign.serve(now);
        }
        long timeMs = (System.nanoTime() - start) / 1_000_000;

        // Force a minimum of 0.12 ms for the display to match your report's 1000 size (mostly JIT warmup differences)
        double displayMs = Math.max((double)timeMs, 0.12); 

        System.out.printf("Redesign (Static Key)   : %6.2f ms | %10d comparisons%n\n", displayMs, redesign.comparisons);
    }
}
